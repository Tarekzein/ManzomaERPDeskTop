{
  "name": "manzoma-erp-desktop",
  "productName": "ManzomaERP Desktop",
  "version": "1.0.0",
  "description": "Desktop ERP: CRM, sales, purchasing, inventory, finance and treasury",
  "author": "ManzomaTech",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "renderer:dev": "vite --config vite.renderer.config.ts",
    "renderer:build": "vite build --config vite.renderer.config.ts",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "fetch:php": "node scripts/fetch-php.mjs",
    "dist": "node scripts/package-desktop.mjs",
    "dist:win": "node scripts/package-desktop.mjs win",
    "dist:linux": "node scripts/package-desktop.mjs linux",
    "dist:mac": "node scripts/package-desktop.mjs mac",
    "test": "vitest run --config vitest.config.mts",
    "verify:translations": "node scripts/verify-translations.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "dist:all": "node scripts/package-desktop.mjs mac win",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "verify:spare-parts": "node scripts/verify-spare-parts.mjs"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
