# Copy to deploy/.env and fill in. Never commit the real file.
APP_NAME="ManzomaERP Server"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://erp.example.com
APP_LOCALE=ar

DB_DATABASE=erp
DB_USERNAME=erp
# The app user needs CREATE DATABASE to add companies (erp:company).
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning
ERP_COMPANY_DB_PREFIX=erp_

# One worker is pinned to one registered company. Replicate the worker service for additional companies.
ERP_WORKER_COMPANY=your_company_slug

# Separate operator dashboard at /control. Run erp:control-install once with an operator email
# and ERP_CONTROL_PASSWORD. Keep the signing private key and APP_KEY out of desktop builds.
ERP_CONTROL_ENABLED=true
ERP_LICENSE_ENFORCE=true
CONTROL_DB_CONNECTION=sqlite
CONTROL_DB_DATABASE=/var/www/erp/storage/app/control/control.sqlite
# Must be the externally reachable HTTPS URL, matching APP_URL and desktop server profiles.
ERP_LICENSE_ISSUER=https://erp.example.com
SESSION_SECURE_COOKIE=true

# Encrypted issuer recovery set; use a secret of at least 16 characters and protect it separately.
ERP_CONTROL_BACKUP_ENABLED=false
ERP_CONTROL_BACKUP_PASSWORD=
ERP_CONTROL_BACKUP_PATH=/var/www/erp/storage/issuer-backups
# Optional JSON array of previously trusted PUBLIC signing keys for a planned issuer rollover.
ERP_LICENSE_LEGACY_PUBLIC_KEYS=
